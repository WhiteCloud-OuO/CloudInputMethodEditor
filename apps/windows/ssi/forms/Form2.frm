[AllCode]
'==================== 常用符号 页 按钮事件 ====================
'左键：把按钮上的字符模拟键盘输入到“当前焦点窗口”
Sub Form2_YFbutton1_WM_LButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   InsertSymbol Form2.YFbutton1(ControlIndex).Caption
End Sub

'右键：把按钮上的字符复制到剪贴板
Sub Form2_YFbutton1_WM_RButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   CopySymbol Form2.YFbutton1(ControlIndex).Caption
End Sub

'常用符号 页中部分字符不在 GBK 代码页内，自动生成时会变成“?”，这里在运行时用 WChr 补正
Sub Form2_WM_Create(hWndForm As hWnd, UserData As Integer)
   Form2.YFbutton1(9).Caption = WChr(&H00BF)
   Form2.YFbutton1(11).Caption = WChr(&H00A6)
   Form2.YFbutton1(14).Caption = WChr(&H2195)
   Form2.YFbutton1(15).Caption = WChr(&H2194)
   Form2.YFbutton1(18).Caption = WChr(&H2611)
   Form2.YFbutton1(19).Caption = WChr(&H266A)
   Form2.YFbutton1(21).Caption = WChr(&H2713)
   Form2.YFbutton1(36).Caption = WChr(&H06DE)
   Form2.YFbutton1(42).Caption = WChr(&H2665)
   Form2.YFbutton1(43).Caption = WChr(&H2663)
   Form2.YFbutton1(44).Caption = WChr(&H2660)
   Form2.YFbutton1(45).Caption = WChr(&H2666)
End Sub
