Function TagArr2CWSTR(tagArr As String) As CWSTR
   If tagArr = "" Then Return ""
   
   Dim arrS() As String
   Split(tagArr ,"|" ,arrS())
   
   Dim result As CWStr = ""
   Dim i      As Integer
   Dim s      As String
   Dim cp     As Integer
   For i = 0 To UBound(arrS)
      s = Trim(arrS(i))
      If s = "" Then Continue For ' 跳过空段
      If Left(s ,2) <> "&H" And Left(s ,2) <> "&h" Then Continue For ' 只处理 &H 开头的
      
      cp = Cast(Integer ,Val(s))
      If cp <= 0 Then Continue For ' 跳过无效值
      
      If cp < &H10000 Then
         result &= WChr(cp)
      Else
         Dim c As Integer = cp - &H10000
         result &= WChr(&HD800 Or (c Shr 10))    ' 高位代理
         result &= WChr(&HDC00 Or (c And &H3FF)) ' 低位代理
      End If
   Next
   Return result
End Function
Sub Form8_Option1_BN_Clicked(ControlIndex As Long ,hWndForm As hWnd ,hWndControl As hWnd) '单击
   'hWndForm    当前窗口的句柄(WIN系统用来识别窗口的一个编号，如果多开本窗口，必须 Me.hWndForm = hWndForm 后才可以执行后续操作本窗口的代码)
   'hWndControl 当前控件的句柄(也是窗口句柄，如果多开本窗口，必须 Me.控件名.hWndForm = hWndForm 后才可以执行后续操作本控件的代码 )
   ChangeText
End Sub

'============================================================
' 把输入框里的英文字母替换为当前选中 Option1 对应的花式字母
'============================================================
Sub ChangeText()
   ' ---- 1. 找到当前选中的 Option1 ----
   Dim selIdx As Integer = -1
   Dim i      As Integer
   For i = LBound(Form8.Option1) To UBound(Form8.Option1)
      If Form8.Option1(i).Value Then
         selIdx = i
         Exit For
      End If
   Next
   If selIdx < 0 Then Exit Sub

   ' ---- 1.5 同步字体 ----
   'Form8.Text2.Font = Form8.Option1(selIdx).Font

   ' ---- 2. 解析 ABCode(selIdx) ----
   Dim arrS() As String
   Split(ABCode(selIdx), "|", arrS())

   ' ★ 找到第一个 &H 开头的元素，跳过可能的 UBound 污染
   Dim startIdx As Integer = 0
   Dim j        As Integer
   For j = 0 To UBound(arrS)
      Dim seg As String = Trim(arrS(j))
      If Left(seg, 2) = "&H" Or Left(seg, 2) = "&h" Then
         startIdx = j
         Exit For
      End If
   Next

   ' 收集所有 &H 元素（过滤 "53" 之类的杂质）
   Dim codeList() As Integer
   Dim cnt As Integer = 0
   ReDim codeList(63)          ' 预留 64 个位置，够用
   For j = startIdx To UBound(arrS)
      Dim s As String = Trim(arrS(j))
      If Left(s, 2) = "&H" Or Left(s, 2) = "&h" Then
         codeList(cnt) = Cast(Integer, Val(s))
         cnt += 1
         If cnt >= 64 Then Exit For
      End If
   Next

   If cnt < 52 Then Exit Sub   ' 数据不全，不处理

   ' ---- 3. 逐字符转换 ----
   Dim src As CWStr = Form8.Text1.Text
   Dim outStr As CWStr = ""
   Dim k As Integer
   Dim ch As CWStr
   Dim idx As Integer
   Dim code As Integer
   For k = 1 To Len(src)
      ch = Mid(src, k, 1)
      If ch >= "A" And ch <= "Z" Then
         idx = Asc(ch) - Asc("A")
         code = codeList(idx)
         If code > 0 Then outStr &= Code2CWStr(code) Else outStr &= ch
      ElseIf ch >= "a" And ch <= "z" Then
         idx = 26 + Asc(ch) - Asc("a")
         code = codeList(idx)
         If code > 0 Then outStr &= Code2CWStr(code) Else outStr &= ch
      Else
         outStr &= ch
      End If
   Next

   ' ---- 4. 写出结果 ----
   Form8.Text2.Text = outStr
End Sub


'============================================================
' 把单个 Unicode 码点（含扩展平面代理对）转成 CWStr
'============================================================
Function Code2CWStr(cp As Integer) As CWStr
    If cp < &H10000 Then
        Return WChr(cp)
    Else
        Dim c As Integer = cp - &H10000
        Return WChr(&HD800 Or (c Shr 10)) & WChr(&HDC00 Or (c And &H3FF))
    End If
End Function

Sub Form8_Text1_EN_Change(hWndForm As hWnd ,hWndControl As hWnd) '文本已经被修改（修改前用 EN_UPDATE
