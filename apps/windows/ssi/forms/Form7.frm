[AllCode]
'==================== 制表符 页 按钮事件 ====================
'左键：把按钮上的字符模拟键盘输入到“当前焦点窗口”
Sub Form7_YFbutton1_WM_LButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   InsertSymbol Form7.YFbutton1(ControlIndex).Caption
End Sub

'右键：把按钮上的字符复制到剪贴板
Sub Form7_YFbutton1_WM_RButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   CopySymbol Form7.YFbutton1(ControlIndex).Caption
End Sub

Sub Form7_Shown(hWndForm As hWnd,UserData As Integer)  '窗口完全显示后。
   'hWndForm  当前窗口的句柄(WIN系统用来识别窗口的一个编号，如果多开本窗口，必须 Me.hWndForm = hWndForm 后才可以执行后续操作本窗口的代码)
   'UserData  来自显示窗口最后1个参数，例： Form2.Show(父窗口句柄,模式,UserData)

End Sub

Sub Form7_WM_Create(hWndForm As hWnd ,UserData As Integer) '完成创建窗口及所有的控件后，此时窗口还未显示。注：自定义消息里 WM_Create 此时还未创建控件和初始赋值。
   'hWndForm  当前窗口的句柄(WIN系统用来识别窗口的一个编号，如果多开本窗口，必须 Me.hWndForm = hWndForm 后才可以执行后续操作本窗口的代码)
   'UserData  来自显示窗口最后1个参数，例： Form7Show(父窗口句柄,模式,UserData)
   Dim i As Integer
   For i =  LBound(Form7.YFbutton1) To UBound(Form7.YFbutton1)
      If CWSTRtoString(Form7.YFbutton1(i).Tag) <> "" Then
         Form7.YFbutton1(i).Caption = WChr(Val(CWSTRtoString(Form7.YFbutton1(i).tag)))
      End If
   Next
End Sub


