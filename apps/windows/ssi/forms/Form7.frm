[AllCode]
'==================== 制表符 页 按钮事件 ====================
'左键：把按钮上的字符模拟键盘输入到“当前焦点窗口”
Sub Form7_YFbutton1_WM_LButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   InsertSymbol Form7.YFbutton1(ControlIndex).Caption
End Sub

'右键：把按钮上的字符复制到剪贴板
Sub Form7_YFbutton1_WM_RButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   CopySymbol Form7.YFbutton1(ControlIndex).Caption
End Sub
