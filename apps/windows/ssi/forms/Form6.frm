[AllCode]
'==================== 日文假名 页 按钮事件 ====================
'右侧三个模式按钮：96=普通(无)  97=浊音(゛)  98=半浊音(゜)
'切换时：改模式按钮配色，并把有浊音/半浊音的假名改为对应写法，其余假名隐藏。

Dim Shared KanaMode As Long = 0          '0=普通 1=浊音 2=半浊音
Dim Shared KanaInit As Long = 0          '是否已初始化
Dim Shared KanaSelF As Long, KanaSelB As Long      '选中时的前景/背景色
Dim Shared KanaUnselF As Long, KanaUnselB As Long  '未选中时的前景/背景色
Dim Shared KVidx(41) As Long
Dim Shared KVp(41) As CWSTR
Dim Shared KVd(41) As CWSTR
Dim Shared KVh(41) As CWSTR

'记录三个模式按钮的“选中/未选中”配色（直接取设计时的值，避免写死颜色）
Sub Form6_SaveModeColors()
   KanaSelF   = Form6.YFbutton1(96).ForeColor
   KanaSelB   = Form6.YFbutton1(96).BackColor
   KanaUnselF = Form6.YFbutton1(97).ForeColor
   KanaUnselB = Form6.YFbutton1(97).BackColor
End Sub

Sub Form6_SetModeBtn(idx As Long, sel As Boolean)
   If sel Then
      Form6.YFbutton1(idx).ForeColor = KanaSelF
      Form6.YFbutton1(idx).BackColor = KanaSelB
   Else
      Form6.YFbutton1(idx).ForeColor = KanaUnselF
      Form6.YFbutton1(idx).BackColor = KanaUnselB
   End If
End Sub

'假名 ->（普通/浊音/半浊音）对照表
Sub Form6_InitKanaMap()
   KVidx(0)=2 : KVp(0)="う" : KVd(0)=WChr(&H3094) : KVh(0)=""
   KVidx(1)=7 : KVp(1)="ウ" : KVd(1)="ヴ" : KVh(1)=""
   KVidx(2)=10 : KVp(2)="か" : KVd(2)="が" : KVh(2)=""
   KVidx(3)=11 : KVp(3)="き" : KVd(3)="ぎ" : KVh(3)=""
   KVidx(4)=12 : KVp(4)="く" : KVd(4)="ぐ" : KVh(4)=""
   KVidx(5)=13 : KVp(5)="け" : KVd(5)="げ" : KVh(5)=""
   KVidx(6)=14 : KVp(6)="こ" : KVd(6)="ご" : KVh(6)=""
   KVidx(7)=15 : KVp(7)="カ" : KVd(7)="ガ" : KVh(7)=""
   KVidx(8)=16 : KVp(8)="キ" : KVd(8)="ギ" : KVh(8)=""
   KVidx(9)=17 : KVp(9)="ク" : KVd(9)="グ" : KVh(9)=""
   KVidx(10)=18 : KVp(10)="ケ" : KVd(10)="ゲ" : KVh(10)=""
   KVidx(11)=19 : KVp(11)="コ" : KVd(11)="ゴ" : KVh(11)=""
   KVidx(12)=20 : KVp(12)="さ" : KVd(12)="ざ" : KVh(12)=""
   KVidx(13)=21 : KVp(13)="し" : KVd(13)="じ" : KVh(13)=""
   KVidx(14)=22 : KVp(14)="す" : KVd(14)="ず" : KVh(14)=""
   KVidx(15)=23 : KVp(15)="せ" : KVd(15)="ぜ" : KVh(15)=""
   KVidx(16)=24 : KVp(16)="そ" : KVd(16)="ぞ" : KVh(16)=""
   KVidx(17)=25 : KVp(17)="サ" : KVd(17)="ザ" : KVh(17)=""
