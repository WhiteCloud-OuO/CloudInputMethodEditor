Sub Form6_SetKanaMode(mode As Long)
   If KanaInit = 0 Then
      Form6_InitKanaMap
      Form6_SaveModeColors
      KanaInit = -1
   End If
   KanaMode = mode
   Dim hf As hWnd = Form6.hWndForm
   SendMessage hf, WM_SETREDRAW, 0, 0   '批量更新期间暂停重画，避免卡顿/闪烁
   Dim i As Long
   '先隐藏全部假名按钮
   For i = 0 To 95
      Form6.YFbutton1(i).Visible = False
   Next
   For i = 99 To 109
      Form6.YFbutton1(i).Visible = False
   Next
   Select Case mode
      Case 0   '普通：全部显示，恢复普通写法
         For i = 0 To 95
            Form6.YFbutton1(i).Visible = True
         Next
         For i = 99 To 109
            Form6.YFbutton1(i).Visible = True
         Next
         For i = 0 To 41
            Form6.YFbutton1(KVidx(i)).Caption = KVp(i)
         Next
      Case 1   '浊音：只显示有浊音的假名
         For i = 0 To 41
            Form6.YFbutton1(KVidx(i)).Visible = True
            Form6.YFbutton1(KVidx(i)).Caption = KVd(i)
         Next
      Case 2   '半浊音：只显示有半浊音的假名
         For i = 0 To 41
            If Len(KVh(i)) Then
               Form6.YFbutton1(KVidx(i)).Visible = True
               Form6.YFbutton1(KVidx(i)).Caption = KVh(i)
            End If
         Next
   End Select
   '更新三个模式按钮的选中状态
   Form6_SetModeBtn 96, (mode = 0)
   Form6_SetModeBtn 97, (mode = 1)
   Form6_SetModeBtn 98, (mode = 2)
   SendMessage hf, WM_SETREDRAW, 1, 0
   InvalidateRect hf, Null, True
   UpdateWindow hf
End Sub

Sub Form6_WM_Create(hWndForm As hWnd, UserData As Integer)  '窗口显示前，初始化为普通模式
   Form6_SetKanaMode 0
End Sub

'左键：96/97/98 切换模式，其余按钮把字符模拟输入到当前焦点窗口
Sub Form6_YFbutton1_WM_LButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   Select Case ControlIndex
      Case 96
         Form6_SetKanaMode 0
      Case 97
         Form6_SetKanaMode 1
      Case 98
         Form6_SetKanaMode 2
      Case Else
         InsertSymbol Form6.YFbutton1(ControlIndex).Caption
   End Select
End Sub

'右键：复制到剪贴板（模式按钮不复制）
Sub Form6_YFbutton1_WM_RButtonUp(ControlIndex As Long, hWndForm As hWnd, MouseFlags As Long, xPos As Long, yPos As Long)
   Select Case ControlIndex
      Case 96, 97, 98
      Case Else
         CopySymbol Form6.YFbutton1(ControlIndex).Caption
   End Select
End Sub
