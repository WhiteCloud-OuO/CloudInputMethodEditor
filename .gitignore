/target
**/*.rs.bk
.DS_Store
*.app
.env
/logs
/data
.playwright-mcp/
/.idea
/WordBank
/LocalDictionary
/Phrases/*
!/Phrases/Phrase.db
# 用户脚本目录：只跟踪模板、测试脚本与示例；
# 用户自己的脚本文件夹（可能带着自己的 API key）一律不进仓库。
/Scripts/*
!/Scripts/template.lua
!/Scripts/test-caret-window/
!/Scripts/examples/
tree.md
version.txt
cargo-build.ps1
reconfigure.ps1
build-installer.ps1
git-push.ps1
clear-products.ps1
.gitignore
/WanXiang
# 双键拼音方案目录（开发布局：仓库根；装机在安装目录，安装程序会建好并授权）
/InputSchemes
