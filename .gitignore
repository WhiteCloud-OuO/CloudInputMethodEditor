/target
**/*.rs.bk
.DS_Store
*.app
.env
/logs
/data
.playwright-mcp/
/.idea
/WordBank
/LocalDictionary
/Phrases/*
!/Phrases/Phrase.db
# 用户脚本目录：只跟踪模板、测试脚本与示例；# 用户自己的脚本文件夹（可能带着自己的 API key）一律不进仓库。
/Scripts/*
!/Scripts/template.lua
!/Scripts/test-caret-window/
!/Scripts/examples/
tree.md
version.txt
cargo-build.ps1
reconfigure.ps1
build-installer.ps1
git-push.ps1
clear-products.ps1
.gitignore
/WanXiang
/tools/root-font

# 双键拼音方案目录是开发 / 装机时的本机配置（样例由程序首次运行写出，随包辅助码表在 assets\auxiliary）；
# 形码方案与五笔码表随仓库提供（码表来源与 MIT 许可见 wubi\NOTICE.md、wubi\LICENSE-wubi86-jidian.txt）
/InputSchemes/DoubleKeysPinyin

# 特殊字符输入器的旧 VFB 工程：只作本机参考，目录内容不进仓库
/apps/windows/ssi/legacy/

# Python 工具（模型导出 / 对拍）
__pycache__/
*.pyc
/.venv*/
