{
  "width": 440,
  "height": 360,
  "controls": [
    {
      "name": "background",
      "type": "rect",
      "x": 0,
      "y": 0,
      "w": 440,
      "h": 360,
      "radius": 12,
      "color": "#FFFFFFFF"
    },
    {
      "name": "title",
      "type": "label",
      "x": 16,
      "y": 16,
      "size": 16,
      "runs": [
        { "text": "在线查询", "color": "#FF222222" }
      ]
    },
    {
      "name": "close",
      "type": "flat_svg_button",
      "x": 400,
      "y": 12,
      "w": 24,
      "h": 24,
      "svg_path": "Images/SVG/打叉.svg",
      "shape": "round_rect",
      "radius": 4,
      "normal": { "background": "#00000000", "svg": "#FF222222" },
      "hovered": { "background": "#FFFF3300", "svg": "#FFFFFFFF" },
      "pressed": { "background": "#FFCC2900", "svg": "#FFFFFFFF" },
      "events": { "mouse_clicked": "close" }
    },
    {
      "name": "query",
      "type": "text_edit",
      "x": 16,
      "y": 52,
      "w": 368,
      "h": 32,
      "font": "pinyin",
      "back_color": "#FFFFFFFF",
      "edge_color": "#FFC8C8C8",
      "text_color": "#FF222222",
      "cursor_color": "#FF0F6CBD",
      "sel_back_color": "#F0C8F1FF",
      "sel_text_color": "#FF222222",
      "text": "",
      "events": { "on_key_pressed": "query_key" }
    },
    {
      "name": "search",
      "type": "flat_svg_button",
      "x": 392,
      "y": 52,
      "w": 32,
      "h": 32,
      "svg_path": "Images/SVG/搜索.svg",
      "shape": "round_rect",
      "radius": 8,
      "normal": { "background": "#FF0F6CBD", "svg": "#FFFFFFFF" },
      "hovered": { "background": "#FF0F6CBD", "svg": "#FFFFFFFF" },
      "pressed": { "background": "#FF0F6CBD", "svg": "#FFFFFFFF" },
      "events": { "mouse_clicked": "search" }
    },
    {
      "name": "status",
      "type": "label",
      "x": 16,
      "y": 92,
      "size": 12,
      "runs": [
        { "text": "", "color": "#FF888888" }
      ]
    },
    {
      "name": "result",
      "type": "text_box",
      "x": 16,
      "y": 112,
      "w": 408,
      "h": 232,
      "radius": 6,
      "read_only": true,
      "auto_line_wrap": true,
      "line_spacing": 6,
      "font": "translate",
      "back_color": "#FFF7F7F7",
      "edge_color": "#FFC8C8C8",
      "text_color": "#FF222222",
      "sel_back_color": "#F0C8F1FF",
      "sel_text_color": "#FF222222",
      "text": "输入中文词语、汉字或英文单词后按回车，或点搜索按钮。"
    }
  ]
}
