#!/usr/bin/env bash
# 推之前跑全 workspace 测试（提交时不跑，太慢）；跳过：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Windows 上 Server 的 build.rs 会嵌 uiAccess manifest，嵌了它的测试二进制没签名起不来（os error 740）；
# 与 ci.yml 的 windows job 一样关掉这一项（其他平台没这项，跑法不变）。
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) export CLOUDIME_UIACCESS=0 ;;
esac
cargo test --workspace --locked
